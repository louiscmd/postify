# Copy to .env.local for local dev, and add the same two variables in Vercel
# (Project → Settings → Environment Variables). Both values are public by design:
# data is protected by Row Level Security (see supabase/schema.sql), not by hiding these.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
